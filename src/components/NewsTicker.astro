---
import { LIVE_WIRE_SOURCES } from '../data/liveWireSources.js';
import { discoverLiveWireItems, selectLiveWirePools, sourceLabel, LIVE_WIRE_TICKER_CONFIG } from '../lib/liveWireDiscovery.js';

const { items: pool } = await discoverLiveWireItems(LIVE_WIRE_SOURCES);
const items = selectLiveWirePools(pool, LIVE_WIRE_TICKER_CONFIG);
---
{items.length>0&&<aside class="news-ticker" aria-label="Latest news from external sources"><div class="ticker-inner container"><strong class="ticker-label"><span aria-hidden="true"></span>Latest News</strong><div class="ticker-window"><div class="ticker-track">{[...items,...items].map(item=><a href={item.link} target="_blank" rel="noopener noreferrer" class={item.sourceType?.startsWith('official-') ? 'official' : ''}><b>{item.title}</b><small>{sourceLabel(item)}</small></a>)}</div></div><a class="ticker-more" href="/live-wire">Live Wire →</a></div></aside>}
<style>
.news-ticker{background:#c2410c;color:#fff;border-bottom:1px solid rgba(255,255,255,.2);overflow:hidden}.ticker-inner{height:38px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:1rem}.ticker-label{display:flex;align-items:center;gap:.45rem;text-transform:uppercase;letter-spacing:.09em;font-size:.72rem;white-space:nowrap}.ticker-label span{width:7px;height:7px;border-radius:50%;background:#fff}.ticker-window{overflow:hidden;mask-image:linear-gradient(to right,transparent,#000 3%,#000 97%,transparent)}.ticker-track{display:flex;width:max-content;align-items:center;animation:ticker 70s linear infinite}.ticker-track:hover{animation-duration:280s}.ticker-track a{display:flex;align-items:center;gap:.55rem;color:#fff;text-decoration:none;white-space:nowrap;font-size:.78rem;padding-right:2.5rem}.ticker-track a::after{content:'•';opacity:.55;margin-left:2rem}.ticker-track small{opacity:.72;font-size:.64rem;text-transform:uppercase;letter-spacing:.06em}.ticker-track a.official small{opacity:1;font-weight:700}.ticker-more{color:#fff;text-decoration:none;font-size:.72rem;font-weight:900;white-space:nowrap}@keyframes ticker{to{transform:translateX(-50%)}}@media(max-width:650px){.ticker-inner{grid-template-columns:auto minmax(0,1fr);gap:.65rem}.ticker-more{display:none}.ticker-label{font-size:.66rem}.ticker-track a{font-size:.74rem;gap:.4rem}.ticker-track small{font-size:.56rem;opacity:.65;flex-shrink:0}}@media(prefers-reduced-motion:reduce){.ticker-track{animation:none;overflow-x:auto}.ticker-window{overflow-x:auto}}
</style>
