---
import NewsTicker from './NewsTicker.astro';
const nav = ['Latest','Local','Government','Schools','Business','Community','Investigations','Opinion'];
---
<NewsTicker />
<header class="site-header">
  <div class="topbar container">
    <button class="menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button><span aria-hidden="true">☰</span></button>
    <a class="brand" href="/" aria-label="CenTex Press home"><span class="brand-main">CenTex Press</span><span class="tagline">Different voices. One community.</span></a>
    <div class="header-actions"><a class="search-link" href="/search" aria-label="Search CenTex Press">⌕</a><a class="lang-link" href="/es" lang="es">ES</a><div class="theme-group" aria-label="Theme options"><button type="button" data-theme-choice="light" aria-label="Use light theme">☀</button><button type="button" data-theme-choice="dark" aria-label="Use dark theme">◐</button><button type="button" data-theme-choice="system" aria-label="Use system theme">A</button></div></div>
  </div>
  <nav class="desktop-nav" aria-label="Primary navigation"><div class="container nav-row">{nav.map((item) => <a href={`/${item.toLowerCase().replaceAll(' ', '-')}`}>{item}</a>)}<a class="live-wire" href="/live-wire"><span aria-hidden="true" class="live-dot"></span>Live Wire</a></div></nav>
  <nav id="mobile-menu" class="mobile-menu" data-mobile-menu hidden aria-label="Mobile navigation"><div class="container mobile-links">{nav.map((item) => <a href={`/${item.toLowerCase().replaceAll(' ', '-')}`}>{item}</a>)}<a href="/live-wire">Live Wire</a><a href="/receipts">The Receipts</a><a href="/events">Events</a><a href="/write-for-us">Write for Us</a><a href="/es" lang="es">Español</a></div></nav>
</header>
<style>
.site-header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--paper) 95%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.topbar{min-height:92px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem}.menu-button{display:none;border:0;background:transparent;color:var(--ink);font-size:1.55rem;padding:.55rem;min-width:44px;min-height:44px}.brand{justify-self:center;text-decoration:none;text-align:center;display:grid;line-height:1}.brand-main{font-family:Georgia,'Times New Roman',serif;font-weight:900;font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.04em}.tagline{margin-top:.45rem;color:var(--muted);font-size:.78rem;letter-spacing:.07em}.header-actions{display:flex;align-items:center;gap:.45rem}.search-link,.lang-link,.theme-group button{min-width:42px;min-height:42px;display:grid;place-items:center;border:0;background:transparent;color:var(--ink);text-decoration:none;font-weight:800}.theme-group{display:flex;border-left:1px solid var(--line);margin-left:.25rem;padding-left:.25rem}.desktop-nav{border-top:1px solid var(--line)}.nav-row{display:flex;justify-content:center;align-items:center;gap:clamp(.75rem,2vw,1.5rem);min-height:48px;white-space:nowrap;overflow-x:auto;scrollbar-width:none}.nav-row::-webkit-scrollbar{display:none}.nav-row a{position:relative;text-decoration:none;font-size:.92rem;font-weight:700}.nav-row a::after{content:'';position:absolute;left:0;right:100%;bottom:-.3rem;height:2px;background:var(--brand);transition:right .18s ease}.nav-row a:hover::after,.nav-row a:focus-visible::after{right:0}.live-wire{display:inline-flex;align-items:center;gap:.4rem}.live-dot{width:.55rem;height:.55rem;border-radius:50%;background:var(--brand);animation:pulse 1.8s ease-in-out infinite}.mobile-menu{border-top:1px solid var(--line);background:var(--surface)}.mobile-links{display:grid;grid-template-columns:1fr 1fr;gap:0;padding-block:.5rem 1rem}.mobile-links a{text-decoration:none;padding:.85rem .2rem;border-bottom:1px solid var(--line);font-weight:750}@keyframes pulse{50%{opacity:.35;transform:scale(.82)}}@media(max-width:780px){.topbar{min-height:68px;grid-template-columns:48px 1fr auto;gap:.35rem;width:min(100% - 1rem,1180px)}.menu-button{display:grid;place-items:center}.brand-main{font-size:clamp(1.45rem,7vw,2.1rem)}.tagline{display:none}.desktop-nav,.theme-group,.lang-link{display:none}.search-link{font-size:1.3rem}}@media(max-width:420px){.mobile-links{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.live-dot{animation:none}.nav-row a::after{transition:none}}
</style>