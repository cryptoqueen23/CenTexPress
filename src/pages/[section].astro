---
import { getCollection } from 'astro:content';
import SectionLayout from '../layouts/SectionLayout.astro';
import { sections } from '../data/sections.js';
export function getStaticPaths(){return Object.keys(sections).map(section=>({params:{section}}));}
const key=Astro.params.section; const [title,hook,description]=sections[key];
const allStories=(await getCollection('stories')).filter(s=>!s.data.draft&&s.data.language==='en').sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const receipts=(await getCollection('receipts')).filter(r=>r.data.language==='en').sort((a,b)=>b.data.documentDate.valueOf()-a.data.documentDate.valueOf());
const now=new Date(); const events=(await getCollection('events')).filter(e=>!e.data.draft&&(e.data.endsAt||e.data.startsAt)>=now).sort((a,b)=>a.data.startsAt.valueOf()-b.data.startsAt.valueOf());
const sectionName=key?key.charAt(0).toUpperCase()+key.slice(1):''; const stories=key==='latest'?allStories:allStories.filter(s=>s.data.section.toLowerCase()===key); const special=['live-wire','receipts','events','write-for-us','about','corrections','advertise','contact','search'].includes(key);
const storyUrl=s=>`/stories/${s.id.replace(/\.(md|mdx)$/,'')}`;
---
<SectionLayout title={title} hook={hook} description={description}>
{!special&&<div class="story-list">{stories.length?stories.map(story=><article><span>{story.data.section}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p><small>{story.data.published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})} · {story.data.author}</small></article>):<p>No published {sectionName.toLowerCase()} stories yet. New stories will appear here automatically when they are published.</p>}</div>}
{key==='receipts'&&<><div class="tool-head"><h2>Read the source material.</h2><p>Documents are listed by agency and date. Each record can link back to the reporting it supports.</p></div><div class="story-list">{receipts.length?receipts.map(r=><article><span>{r.data.documentType} · {r.data.agency}</span><h2><a href={r.data.fileUrl}>{r.data.title}</a></h2><p>{r.data.description}</p><small>{r.data.documentDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}{r.data.relatedStory&&<> · <a href={r.data.relatedStory}>Related story</a></>}</small></article>):<p>No public documents have been published yet.</p>}</div></>}
{key==='events'&&<><div class="tool-head"><h2>Upcoming Central Texas events</h2><p>Past events are removed from this list automatically.</p></div><div class="story-list">{events.length?events.map(e=><article><span>{e.data.city}</span><h2>{e.data.url?<a href={e.data.url}>{e.data.title}</a>:e.data.title}</h2><p>{e.data.description}</p><small>{e.data.startsAt.toLocaleString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'})} · {e.data.venue}</small></article>):<p>No upcoming events have been published yet.</p>}</div></>}
{key==='write-for-us'&&<><h2>Different voices belong here.</h2><p>We welcome residents who want to report, explain or share a clearly labeled perspective. Submissions are reviewed before publication. Facts and sources come first.</p><p><a href="/contact">Contact CenTex Press about contributing →</a></p></>}
{key==='search'&&<><h2>Search published stories</h2><form class="search" role="search"><label for="story-search">Search CenTex Press</label><div><input id="story-search" type="search" placeholder="Search headlines, topics or sections" autocomplete="off"/><button type="button">Search</button></div></form><div id="search-results" class="story-list">{allStories.map(story=><article data-search={`${story.data.title} ${story.data.description} ${story.data.section}`.toLowerCase()}><span>{story.data.section}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p></article>)}</div><script is:inline>{`const input=document.querySelector('#story-search');const items=[...document.querySelectorAll('#search-results article')];input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();items.forEach(el=>el.hidden=q&&!el.dataset.search.includes(q));});`}</script></>}
{key==='contact'&&<><h2>Send a tip or message</h2><p>The submission interface is ready for a secure backend. CenTex Press will not collect names, email addresses, documents or tips until the destination and privacy handling are connected.</p><div class="choices"><a href="/write-for-us"><strong>Write for CenTex</strong><span>Contributor information and editorial standards</span></a><a href="/advertise"><strong>Advertise</strong><span>Local advertising and sponsorship inquiries</span></a><a href="/events"><strong>Events</strong><span>See the public events calendar</span></a></div></>}
{key==='live-wire'&&<p>See something we should know about? <a href="/contact">Send us a tip <span aria-hidden="true">→</span></a></p>}
{key==='about'&&<><h2>Local reporting built around the record.</h2><p>CenTex Press is independent and digital-first. We cover Central Texas with an emphasis on public documents, clear explanations and community voices.</p></>}
{key==='corrections'&&<><h2>Corrections policy</h2><p>When a material factual error is confirmed, CenTex Press will correct the story and clearly note the change.</p></>}
{key==='advertise'&&<><h2>Support local reporting. Reach local readers.</h2><p>CenTex Press offers clearly labeled local advertising and sponsorship placements without disguising advertising as journalism.</p><p><a href="/contact">Advertising contact →</a></p></>}
</SectionLayout>
<style>.story-list{display:grid}.story-list article{padding:1.5rem 0;border-bottom:1px solid var(--line)}.story-list article>span{color:var(--brand);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.story-list h2{margin:.4rem 0!important}.story-list h2 a{text-decoration:none}.story-list h2 a:hover{text-decoration:underline}.story-list small{color:var(--muted)}.tool-head{padding-bottom:1rem;border-bottom:1px solid var(--line)}.search{margin:1.5rem 0 2rem}.search label{display:block;font-weight:900;margin-bottom:.5rem}.search div{display:flex}.search input{flex:1;min-width:0;padding:.9rem 1rem;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit}.search button{padding:.9rem 1.2rem;border:0;background:var(--brand);color:white;font-weight:900}.choices{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin-top:2rem}.choices a{padding:1.2rem;text-decoration:none;border-right:1px solid var(--line)}.choices a:last-child{border:0}.choices span{display:block;color:var(--muted);font-size:.82rem;margin-top:.3rem}@media(max-width:560px){.search div,.choices{display:grid;grid-template-columns:1fr}.search button{width:100%}.choices a{border-right:0;border-bottom:1px solid var(--line)}} </style>