---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionLayout from '../layouts/SectionLayout.astro';
import { sections } from '../data/sections.js';
import { LIVE_WIRE_SOURCES } from '../data/liveWireSources.js';
import { discoverLiveWireItems, sourceLabel } from '../lib/liveWireDiscovery.js';
export function getStaticPaths(){return Object.keys(sections).filter(section=>section!=='about'&&section!=='advertise'&&section!=='contact').map(section=>({params:{section}}));}
const key=Astro.params.section; const [title,hook,description]=sections[key];
const allStories=(await getCollection('stories')).filter(s=>!s.data.draft&&s.data.language==='en').sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const receipts=(await getCollection('receipts')).filter(r=>r.data.language==='en').sort((a,b)=>b.data.documentDate.valueOf()-a.data.documentDate.valueOf());
const now=new Date(); const events=(await getCollection('events')).filter(e=>!e.data.draft&&(e.data.endsAt||e.data.startsAt)>=now).sort((a,b)=>a.data.startsAt.valueOf()-b.data.startsAt.valueOf());
const sectionName=key?key.charAt(0).toUpperCase()+key.slice(1):''; const stories=key==='latest'?allStories:allStories.filter(s=>s.data.section.toLowerCase()===key); const special=['live-wire','receipts','events','write-for-us','corrections','search','opinion'].includes(key);
const storyUrl=s=>`/stories/${s.id.replace(/\.(md|mdx)$/,'')}`;
const opinionGroups=key==='opinion'?[
  {key:'From the Publisher',blurb:'Signed columns from Marimer Cruz-Nieves, Publisher of CenTex Press — personal analysis and viewpoint, not straight news reporting.'},
  {key:'Community Voices',blurb:'Commentary from CenTex Press contributors and members of our community. The views expressed are those of the author and do not necessarily reflect the views of CenTex Press.'},
  {key:'Letters to the Editor',blurb:'Reader letters responding to CenTex Press coverage or raising issues that matter to Central Texas.'},
].map(g=>({...g,stories:stories.filter(s=>s.data.opinionCategory===g.key)})):[];
const uncategorizedOpinion=key==='opinion'?stories.filter(s=>!s.data.opinionCategory):[];
const liveWireItems=key==='live-wire'?(await discoverLiveWireItems(LIVE_WIRE_SOURCES)).items:[];
---
<SectionLayout title={title} hook={hook} description={description}>
{!special&&<div class="story-list">{stories.length?stories.map(story=><article>{story.data.image&&<Image class="thumb" src={story.data.image} alt="" width={160} height={120} />}<div class="story-text"><span>{story.data.section}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p><small>{story.data.published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})} · {story.data.author}</small></div></article>):<p>No published {sectionName.toLowerCase()} stories yet. New stories will appear here automatically when they are published.</p>}</div>}
{key==='receipts'&&<><div class="tool-head"><h2>Read the source material.</h2><p>Documents are listed by agency and date. Each record can link back to the reporting it supports.</p></div><div class="story-list">{receipts.length?receipts.map(r=><article><span>{r.data.documentType} · {r.data.agency}</span><h2><a href={r.data.fileUrl}>{r.data.title}</a></h2><p>{r.data.description}</p><small>{r.data.documentDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}{r.data.relatedStory&&<> · <a href={r.data.relatedStory}>Related story</a></>}</small></article>):<p>No public documents have been published yet.</p>}</div></>}
{key==='events'&&<><div class="tool-head"><h2>Upcoming Central Texas events</h2><p>Past events are removed from this list automatically.</p></div><div class="story-list">{events.length?events.map(e=><article><span>{e.data.city}</span><h2>{e.data.url?<a href={e.data.url}>{e.data.title}</a>:e.data.title}</h2><p>{e.data.description}</p><small>{e.data.startsAt.toLocaleString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'})} · {e.data.venue}</small></article>):<p>No upcoming events have been published yet.</p>}</div></>}
{key==='write-for-us'&&<><h2>Different voices belong here.</h2><p>We welcome residents who want to report, explain or share a clearly labeled perspective. Submissions are reviewed before publication. Facts and sources come first.</p><p><a href="/contact">Contact CenTex Press about contributing →</a></p></>}
{key==='search'&&<><h2>Search published stories</h2><form class="search" role="search"><label for="story-search">Search CenTex Press</label><div><input id="story-search" type="search" placeholder="Search headlines, topics or sections" autocomplete="off"/><button type="button">Search</button></div></form><div id="search-results" class="story-list">{allStories.map(story=><article data-search={`${story.data.title} ${story.data.description} ${story.data.section}`.toLowerCase()}>{story.data.image&&<Image class="thumb" src={story.data.image} alt="" width={160} height={120} />}<div class="story-text"><span>{story.data.section}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p></div></article>)}</div><script is:inline>{`const input=document.querySelector('#story-search');const items=[...document.querySelectorAll('#search-results article')];input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();items.forEach(el=>el.hidden=q&&!el.dataset.search.includes(q));});`}</script></>}
{key==='live-wire'&&<><p class="live-wire-tip">See something we should know about? <a href="/contact">Send us a tip <span aria-hidden="true">→</span></a></p><div class="story-list live-wire-list">{liveWireItems.length?liveWireItems.map(item=><article><div class="story-text"><span>{sourceLabel(item)}</span><h2><a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a></h2>{item.summary&&<p>{item.summary}</p>}<small>{item.published&&new Date(item.published).toLocaleString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'})}</small></div></article>):<p>Nothing new from our sources right now. Check back soon.</p>}</div></>}
{key==='corrections'&&<><h2>Corrections Policy</h2><p><strong>Accuracy matters.</strong> When CenTex Press confirms a material factual error, we will correct it promptly and clearly note what was changed. We will not silently alter significant facts.</p><p>Minor spelling, grammar, formatting, or style edits that do not change the meaning of a story may be corrected without a formal correction notice.</p><p>Readers who believe we got something wrong can <a href="/contact">contact us</a> with the specific information and, when possible, supporting documentation. We will review correction requests fairly and update the story when the evidence warrants it.</p><p><strong>Our goal is simple: get the facts right, and when we don't, own it and fix it.</strong></p></>}
{key==='opinion'&&<div class="opinion-groups">{opinionGroups.map(group=><section class="opinion-group"><div class="tool-head"><h2>{group.key}</h2><p>{group.blurb}</p></div><div class="story-list">{group.stories.length?group.stories.map(story=><article>{story.data.image&&<Image class="thumb" src={story.data.image} alt="" width={160} height={120} />}<div class="story-text"><span>{group.key}{story.data.columnName&&<> | {story.data.columnName}</>}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p><small>{story.data.published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})} · {story.data.author}{story.data.authorRole&&<> · {story.data.authorRole}</>}</small></div></article>):<p>No {group.key.toLowerCase()} published yet.</p>}</div></section>)}{uncategorizedOpinion.length>0&&<section class="opinion-group"><div class="tool-head"><h2>More Opinion</h2></div><div class="story-list">{uncategorizedOpinion.map(story=><article>{story.data.image&&<Image class="thumb" src={story.data.image} alt="" width={160} height={120} />}<div class="story-text"><span>{story.data.section}</span><h2><a href={storyUrl(story)}>{story.data.title}</a></h2><p>{story.data.description}</p><small>{story.data.published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})} · {story.data.author}</small></div></article>)}</div></section>}</div>}
</SectionLayout>
<style>.live-wire-tip{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--line)}.live-wire-list .story-text>span{display:inline-flex;border:1px solid var(--brand);padding:.2rem .55rem;margin-bottom:.6rem}.opinion-group{margin-bottom:2.5rem}.opinion-group:last-child{margin-bottom:0}.story-list{display:grid}.story-list article{display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem 0;border-bottom:1px solid var(--line)}.story-list .thumb{width:140px;height:100px;object-fit:cover;flex-shrink:0}.story-list .story-text{min-width:0}.story-list .story-text>span{color:var(--brand);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.story-list h2{margin:.4rem 0!important}.story-list h2 a{text-decoration:none}.story-list h2 a:hover{text-decoration:underline}.story-list small{color:var(--muted)}@media(max-width:560px){.story-list .thumb{width:96px;height:72px}}.tool-head{padding-bottom:1rem;border-bottom:1px solid var(--line)}.search{margin:1.5rem 0 2rem}.search label{display:block;font-weight:900;margin-bottom:.5rem}.search div{display:flex}.search input{flex:1;min-width:0;padding:.9rem 1rem;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit}.search button{padding:.9rem 1.2rem;border:0;background:var(--brand);color:white;font-weight:900}.choices{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin-top:2rem}.choices a{padding:1.2rem;text-decoration:none;border-right:1px solid var(--line)}.choices a:last-child{border:0}.choices span{display:block;color:var(--muted);font-size:.82rem;margin-top:.3rem}@media(max-width:560px){.search div,.choices{display:grid;grid-template-columns:1fr}.search button{width:100%}.choices a{border-right:0;border-bottom:1px solid var(--line)}} </style>