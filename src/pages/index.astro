---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AdSlot from '../components/AdSlot.astro';

const topStories = [
  { section:'Government', title:'TIRZ No. 2: the documents residents should read', dek:'Plans, public records and the questions behind a major development proposal.' },
  { section:'Schools', title:'Inside the numbers: what the CCISD budget shows', dek:'A plain-English look at spending, staffing and the numbers behind the headlines.' },
  { section:'Community', title:'Around CenTex: people, events and the week ahead', dek:'What is happening across Copperas Cove, Gatesville, Killeen and neighboring communities.' }
];
const live = ['Copperas Cove council documents posted for review','Gatesville meeting agenda added to the calendar','New public records added to The Receipts'];
---
<BaseLayout title="CenTex Press | Different voices. One community.">
  <SiteHeader />
  <main id="main">
    <section class="hero container" aria-labelledby="lead-title">
      <article class="lead story-panel">
        <div class="photo photo-main"><span class="photo-note">Lead story photography</span></div>
        <div class="story-copy">
          <span class="eyebrow">Top Story</span>
          <h1 id="lead-title">Local decisions. Public documents. The story behind the headline.</h1>
          <p>CenTex Press brings Central Texas reporting, public records and community voices together in one place.</p>
          <a class="cta" href="#latest">Read the latest <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <aside class="side-stack" aria-label="Top stories">
        {topStories.slice(0,2).map((story, i) => <article class="side-story">
          <div class={`photo photo-${i+2}`} aria-hidden="true"></div>
          <div><span class="eyebrow">{story.section}</span><h2>{story.title}</h2><p>{story.dek}</p><a href="#">Read story <span aria-hidden="true">→</span></a></div>
        </article>)}
      </aside>
    </section>

    <section class="live container" aria-labelledby="live-title">
      <div class="live-label"><span class="pulse" aria-hidden="true"></span><div><strong id="live-title">CenTex Live</strong><small>Quick updates across Central Texas</small></div></div>
      <div class="live-items">{live.map((item,i)=><a href="#"><time>{['10:24 AM','9:12 AM','8:47 AM'][i]}</time>{item}</a>)}</div>
      <a class="view-all" href="#">View all</a>
    </section>

    <div class="container"><AdSlot /></div>

    <section class="container section" id="latest">
      <header class="section-head"><div><span class="eyebrow">Across the region</span><h2 class="section-title">Top Stories</h2></div><a href="#">View all stories →</a></header>
      <div class="story-grid">{topStories.map((story,i)=><article class="story-card"><div class={`photo card-photo photo-${i+2}`}></div><span class="eyebrow">{story.section}</span><h3>{story.title}</h3><p>{story.dek}</p><a href="#">Read story →</a></article>)}</div>
    </section>

    <nav class="quick container" aria-label="Newsroom tools">
      <a href="#government"><b>Government Watch</b><span>Meetings, budgets and votes</span></a>
      <a href="#receipts"><b>The Receipts</b><span>Documents and public records</span></a>
      <a href="#live-title"><b>CenTex Live</b><span>Fast local updates</span></a>
      <a href="#events"><b>Events</b><span>What is happening nearby</span></a>
      <a href="#tips"><b>Submit a Tip</b><span>Help us follow the story</span></a>
    </nav>

    <section class="split container section">
      <article id="receipts"><span class="eyebrow">Documents. Data. Transparency.</span><h2 class="section-title">The Receipts</h2><p>See the records behind our reporting. Agendas, budgets, ordinances, contracts and public information requests belong close to the story, not buried in a filing cabinet.</p><a class="text-link" href="#">Search documents →</a></article>
      <article><span class="eyebrow">Straight answers</span><h2 class="section-title">CT Explains</h2><p>Government language can be difficult on purpose or by accident. CT breaks down the terms, numbers and processes in plain English.</p><a class="text-link" href="#">Explore explainers →</a></article>
    </section>

    <section class="community section">
      <div class="container community-inner"><div><span class="eyebrow">Different voices. One community.</span><h2 class="section-title">Your community belongs in the newsroom.</h2><p>Pitch a story, send a document, submit an event or write from your perspective. Reporting and opinion are clearly labeled. Facts and sources come first.</p></div><div class="community-actions"><a class="cta" href="#tips">Submit a tip →</a><a class="ghost" href="#">Write for CenTex →</a></div></div>
    </section>
  </main>
  <footer><div class="container footer-grid"><div><strong>CenTex Press</strong><p>Different voices. One community.</p></div><div><a href="#">About</a> · <a href="#">Corrections</a> · <a href="#">Advertise</a> · <a href="#">Contact</a></div><p>Independent Central Texas community news.</p></div></footer>
</BaseLayout>

<style>
  :global(:root){--paper:#07121c;--surface:#0b1a27;--surface2:#102333;--ink:#f7f1e7;--muted:#aab7c1;--line:#284052;--brand:#e3272d;--brand-strong:#ff4147;--navy:#d7e7f7;--shadow:0 18px 55px rgba(0,0,0,.28)}
  :global(html[data-theme='light']){--paper:#f5f1e8;--surface:#fffdf8;--surface2:#eee9df;--ink:#102235;--muted:#5d6870;--line:#c9c4ba;--brand:#b71920;--brand-strong:#95131a;--navy:#102a45;--shadow:0 16px 45px rgba(20,35,45,.09)}
  .hero{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(290px,.8fr);gap:1rem;padding-top:1rem}.story-panel,.side-story,.story-card,.split article{border:1px solid var(--line);background:var(--surface)}.lead{min-height:540px;position:relative;overflow:hidden}.photo{background:linear-gradient(145deg,#213d52,#6d432c 60%,#111);min-height:180px}.photo-main{position:absolute;inset:0;min-height:100%;opacity:.76}.photo-note{position:absolute;right:1rem;top:1rem;color:#fff8;font-size:.7rem}.story-copy{position:absolute;inset:auto 0 0;padding:clamp(1.3rem,4vw,3rem);background:linear-gradient(transparent,rgba(2,8,14,.96) 40%);color:#fff}.story-copy h1{font:700 clamp(2.2rem,5vw,4.7rem)/.98 Georgia,serif;letter-spacing:-.04em;max-width:900px;margin:.4rem 0 1rem}.story-copy p{max-width:660px;color:#d7dee3;font-size:1.05rem}.cta,.ghost{display:inline-flex;align-items:center;gap:.8rem;padding:.8rem 1.15rem;text-decoration:none;font-weight:800;border:1px solid transparent;transition:transform .18s ease,background .18s ease}.cta{background:var(--brand);color:white}.cta:hover{transform:translateY(-2px);background:var(--brand-strong)}.side-stack{display:grid;gap:1rem}.side-story{display:grid;grid-template-rows:150px 1fr;overflow:hidden}.side-story div:last-child{padding:1rem}.side-story h2{font:700 1.5rem/1.05 Georgia,serif;margin:.35rem 0}.side-story p{color:var(--muted);font-size:.9rem}.side-story a,.story-card a,.text-link{font-weight:800;color:var(--ink);text-decoration-thickness:2px;text-underline-offset:4px}.live{margin-top:1rem;border:1px solid var(--line);display:grid;grid-template-columns:auto 1fr auto;align-items:stretch;background:var(--surface)}.live-label{display:flex;gap:.7rem;align-items:center;padding:1rem 1.2rem;border-right:1px solid var(--line)}.live-label strong{font:700 1.35rem Georgia,serif}.live-label small{display:block;color:var(--muted)}.pulse{width:10px;height:10px;border-radius:50%;background:var(--brand);box-shadow:0 0 0 6px color-mix(in srgb,var(--brand) 18%,transparent);animation:pulse 2s infinite}.live-items{display:grid;grid-template-columns:repeat(3,1fr)}.live-items a{padding:.85rem 1rem;text-decoration:none;border-right:1px solid var(--line);font-size:.84rem}.live-items time{display:block;color:var(--brand-strong);font-weight:800}.view-all{align-content:center;padding:1rem;text-decoration:none;font-weight:800}.section{padding-block:3.5rem}.section-head{display:flex;justify-content:space-between;align-items:end;border-bottom:2px solid var(--ink);padding-bottom:.8rem;margin-bottom:1.2rem}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.story-card{padding-bottom:1.1rem}.story-card>:not(.photo){margin-left:1rem;margin-right:1rem}.card-photo{margin:0 0 1rem!important;min-height:210px}.story-card h3{font:700 1.55rem/1.08 Georgia,serif;margin-top:.35rem;margin-bottom:.5rem}.story-card p{color:var(--muted)}.quick{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);background:var(--surface)}.quick a{padding:1.2rem;text-align:center;text-decoration:none;border-right:1px solid var(--line)}.quick a:last-child{border:0}.quick span{display:block;color:var(--muted);font-size:.78rem;margin-top:.2rem}.split{display:grid;grid-template-columns:1.15fr .85fr;gap:1rem}.split article{padding:clamp(1.5rem,4vw,3rem)}.split p{font-size:1.08rem;color:var(--muted);max-width:65ch}.community{background:var(--surface2);border-block:1px solid var(--line)}.community-inner{display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center}.community-inner p{max-width:760px;color:var(--muted);font-size:1.08rem}.community-actions{display:flex;gap:.7rem}.ghost{border-color:var(--line);color:var(--ink)}footer{padding:3rem 0;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1fr auto;gap:1rem}.footer-grid>p{grid-column:1/-1;color:var(--muted)}
  .photo-2{background:linear-gradient(145deg,#19374d,#805d34)}.photo-3{background:linear-gradient(145deg,#303f46,#173049)}.photo-4{background:linear-gradient(145deg,#4b2b27,#142d3c)}
  @keyframes pulse{50%{box-shadow:0 0 0 11px transparent}}
  @media(max-width:850px){.hero{grid-template-columns:1fr}.lead{min-height:560px}.side-stack{grid-template-columns:1fr 1fr}.live{grid-template-columns:1fr}.live-label{border-right:0;border-bottom:1px solid var(--line)}.live-items{grid-template-columns:1fr}.live-items a{border-right:0;border-bottom:1px solid var(--line)}.view-all{display:none}.story-grid{grid-template-columns:1fr 1fr}.quick{grid-template-columns:repeat(2,1fr)}.quick a{border-bottom:1px solid var(--line)}.split{grid-template-columns:1fr}.community-inner{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}}
  @media(max-width:560px){.hero{width:100%;padding-top:0}.lead{border-inline:0;min-height:610px}.story-copy h1{font-size:clamp(2.2rem,11vw,3.3rem)}.side-stack{grid-template-columns:1fr;padding-inline:1rem}.live{width:calc(100% - 2rem)}.story-grid{grid-template-columns:1fr}.quick{grid-template-columns:1fr 1fr}.quick a:nth-child(5){grid-column:1/-1}.community-actions{flex-direction:column}.section{padding-block:2.5rem}.section-head{align-items:start;gap:1rem}.section-head>a{font-size:.8rem}}
</style>