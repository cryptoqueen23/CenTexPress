---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
const stories=(await getCollection('stories')).filter(s=>!s.data.draft&&s.data.language==='en').sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const featured=stories.find(s=>s.data.featured)||stories[0];
const secondary=stories.filter(s=>s.id!==featured?.id).slice(0,2);
const storyUrl=(s)=>`/stories/${s.id.replace(/\.(md|mdx)$/,'')}`;
---
<BaseLayout title="CenTex Press | Different voices. One community.">
<SiteHeader />
<main id="main">
<section class="hero container" aria-labelledby="lead-title">
{featured ? <article class="lead story-panel"><div class="photo photo-main" aria-hidden="true"></div><div class="story-copy"><span class="eyebrow">{featured.data.section}</span><h1 id="lead-title">{featured.data.title}</h1><p>{featured.data.description}</p><a class="cta" href={storyUrl(featured)}>Read the story <span aria-hidden="true">→</span></a></div></article> : <article class="lead story-panel"><div class="story-copy"><span class="eyebrow">CenTex Press</span><h1 id="lead-title">Different voices. One community.</h1><p>Independent Central Texas community news.</p></div></article>}
<aside class="side-stack" aria-label="More stories">{secondary.length ? secondary.map((story,i)=><article class="side-story"><div class={`photo photo-${i+2}`} aria-hidden="true"></div><div><span class="eyebrow">{story.data.section}</span><h2>{story.data.title}</h2><p>{story.data.description}</p><a href={storyUrl(story)}>Read story <span aria-hidden="true">→</span></a></div></article>) : <article class="side-story welcome"><div><span class="eyebrow">Newsroom</span><h2>More Central Texas reporting is coming.</h2><p>Newly published stories will fill this space automatically.</p><a href="/latest">Latest stories →</a></div></article>}</aside>
</section>
<section class="live container"><div class="live-label"><span class="pulse" aria-hidden="true"></span><div><strong>CenTex Live</strong><small>Quick updates across Central Texas</small></div></div><div class="live-copy">Developing updates will appear here as the CenTex Live feed is published.</div><a class="view-all" href="/live-wire">View live wire</a></section>
<div class="container"><AdSlot /></div>
<section class="container section"><header class="section-head"><div><span class="eyebrow">Across the region</span><h2 class="section-title">Latest</h2></div><a href="/latest">View all stories →</a></header><div class="story-grid">{stories.slice(0,3).map((story,i)=><article class="story-card"><div class={`photo card-photo photo-${i+2}`} aria-hidden="true"></div><span class="eyebrow">{story.data.section}</span><h3>{story.data.title}</h3><p>{story.data.description}</p><a href={storyUrl(story)}>Read story →</a></article>)}</div></section>
<nav class="quick container" aria-label="Newsroom tools"><a href="/government"><b>Government Watch</b><span>Meetings, budgets and votes</span></a><a href="/receipts"><b>The Receipts</b><span>Documents and public records</span></a><a href="/live-wire"><b>CenTex Live</b><span>Fast local updates</span></a><a href="/events"><b>Events</b><span>What is happening nearby</span></a><a href="/contact"><b>Submit a Tip</b><span>Help us follow the story</span></a></nav>
<section class="split container section"><article><span class="eyebrow">Documents. Data. Transparency.</span><h2 class="section-title">The Receipts</h2><p>See the records behind our reporting. Agendas, budgets, ordinances, contracts and public information requests belong close to the story.</p><a class="text-link" href="/receipts">Search documents →</a></article><article><span class="eyebrow">Straight answers</span><h2 class="section-title">CT Explains</h2><p>Government language can be complicated. CenTex Press breaks down terms, numbers and processes in plain English.</p><a class="text-link" href="/government">Explore government coverage →</a></article></section>
<section class="community section"><div class="container community-inner"><div><span class="eyebrow">Different voices. One community.</span><h2 class="section-title">Your community belongs in the newsroom.</h2><p>Pitch a story, send a document, submit an event or write from your perspective. Reporting and opinion are clearly labeled. Facts and sources come first.</p></div><div class="community-actions"><a class="cta" href="/contact">Submit a tip →</a><a class="ghost" href="/write-for-us">Write for CenTex →</a></div></div></section>
</main>
<SiteFooter />
</BaseLayout>
<style>
:global(:root){--paper:#07121c;--surface:#0b1a27;--surface2:#102333;--ink:#f7f1e7;--muted:#aab7c1;--line:#284052;--brand:#e3272d;--brand-strong:#ff4147;--navy:#d7e7f7;--shadow:0 18px 55px rgba(0,0,0,.28)}:global(html[data-theme='light']){--paper:#f5f1e8;--surface:#fffdf8;--surface2:#eee9df;--ink:#102235;--muted:#5d6870;--line:#c9c4ba;--brand:#b71920;--brand-strong:#95131a;--navy:#102a45;--shadow:0 16px 45px rgba(20,35,45,.09)}.hero{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(290px,.8fr);gap:1rem;padding-top:1rem}.story-panel,.side-story,.story-card,.split article{border:1px solid var(--line);background:var(--surface)}.lead{min-height:540px;position:relative;overflow:hidden}.photo{background:linear-gradient(145deg,#213d52,#6d432c 60%,#111);min-height:180px}.photo-main{position:absolute;inset:0;min-height:100%;opacity:.76}.story-copy{position:absolute;inset:auto 0 0;padding:clamp(1.3rem,4vw,3rem);background:linear-gradient(transparent,rgba(2,8,14,.96) 40%);color:#fff}.story-copy h1{font:700 clamp(2.2rem,5vw,4.7rem)/.98 Georgia,serif;letter-spacing:-.04em;max-width:900px;margin:.4rem 0 1rem}.story-copy p{max-width:660px;color:#d7dee3;font-size:1.05rem}.eyebrow{color:var(--brand-strong);font-size:.75rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.cta,.ghost{display:inline-flex;align-items:center;gap:.8rem;padding:.8rem 1.15rem;text-decoration:none;font-weight:800;border:1px solid transparent;transition:transform .18s ease,background .18s ease}.cta{background:var(--brand);color:white}.cta:hover{transform:translateY(-2px);background:var(--brand-strong)}.side-stack{display:grid;gap:1rem}.side-story{display:grid;grid-template-rows:150px 1fr;overflow:hidden}.side-story.welcome{grid-template-rows:1fr}.side-story div:last-child{padding:1rem}.side-story h2{font:700 1.5rem/1.05 Georgia,serif;margin:.35rem 0}.side-story p,.story-card p{color:var(--muted)}.side-story a,.story-card a,.text-link{font-weight:800;color:var(--ink);text-underline-offset:4px}.live{margin-top:1rem;border:1px solid var(--line);display:grid;grid-template-columns:auto 1fr auto;align-items:center;background:var(--surface)}.live-label{display:flex;gap:.7rem;align-items:center;padding:1rem 1.2rem;border-right:1px solid var(--line)}.live-label strong{font:700 1.35rem Georgia,serif}.live-label small{display:block;color:var(--muted)}.pulse{width:10px;height:10px;border-radius:50%;background:var(--brand);box-shadow:0 0 0 6px color-mix(in srgb,var(--brand) 18%,transparent);animation:pulse 2s infinite}.live-copy{padding:1rem;color:var(--muted)}.view-all{padding:1rem;text-decoration:none;font-weight:800}.section{padding-block:3.5rem}.section-head{display:flex;justify-content:space-between;align-items:end;border-bottom:2px solid var(--ink);padding-bottom:.8rem;margin-bottom:1.2rem}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.story-card{padding-bottom:1.1rem}.story-card>:not(.photo){margin-left:1rem;margin-right:1rem}.card-photo{margin:0 0 1rem!important;min-height:210px}.story-card h3{font:700 1.55rem/1.08 Georgia,serif;margin-top:.35rem;margin-bottom:.5rem}.quick{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);background:var(--surface)}.quick a{padding:1.2rem;text-align:center;text-decoration:none;border-right:1px solid var(--line)}.quick a:last-child{border:0}.quick span{display:block;color:var(--muted);font-size:.78rem;margin-top:.2rem}.split{display:grid;grid-template-columns:1.15fr .85fr;gap:1rem}.split article{padding:clamp(1.5rem,4vw,3rem)}.split p{font-size:1.08rem;color:var(--muted);max-width:65ch}.community{background:var(--surface2);border-block:1px solid var(--line)}.community-inner{display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center}.community-inner p{max-width:760px;color:var(--muted);font-size:1.08rem}.community-actions{display:flex;gap:.7rem}.ghost{border-color:var(--line);color:var(--ink)}.photo-2{background:linear-gradient(145deg,#19374d,#805d34)}.photo-3{background:linear-gradient(145deg,#303f46,#173049)}.photo-4{background:linear-gradient(145deg,#4b2b27,#142d3c)}@keyframes pulse{50%{box-shadow:0 0 0 11px transparent}}@media(max-width:850px){.hero{grid-template-columns:1fr}.lead{min-height:560px}.side-stack{grid-template-columns:1fr 1fr}.live{grid-template-columns:1fr}.live-label{border-right:0;border-bottom:1px solid var(--line)}.story-grid{grid-template-columns:1fr 1fr}.quick{grid-template-columns:repeat(2,1fr)}.quick a{border-bottom:1px solid var(--line)}.split{grid-template-columns:1fr}.community-inner{grid-template-columns:1fr}}@media(max-width:560px){.hero{width:100%;padding-top:0}.lead{border-inline:0;min-height:610px}.story-copy h1{font-size:clamp(2.2rem,11vw,3.3rem)}.side-stack{grid-template-columns:1fr;padding-inline:1rem}.live{width:calc(100% - 2rem)}.story-grid{grid-template-columns:1fr}.quick{grid-template-columns:1fr 1fr}.quick a:nth-child(5){grid-column:1/-1}.community-actions{flex-direction:column}.section{padding-block:2.5rem}.section-head{align-items:start;gap:1rem}.section-head>a{font-size:.8rem}}
</style>