.about-head{border-bottom:2px solid var(--ink);padding-bottom:1.5rem;margin-bottom:2rem}
.about-head h1{font:900 clamp(2.4rem,6vw,4.2rem)/.98 Georgia,serif;letter-spacing:-.04em;margin:0 0 .6rem}
.about-tagline{font:700 clamp(1.2rem,2.6vw,1.6rem)/1.2 Georgia,serif;color:var(--brand);margin:0}
.about-body p{font-size:1.05rem;line-height:1.75;color:var(--muted);margin:0 0 1.35rem;max-width:70ch}
.about-body strong{color:var(--ink)}
.about-body a{color:var(--ink);font-weight:800;text-underline-offset:4px}
.about-body h2{font:800 clamp(1.5rem,3.2vw,2.1rem)/1.1 Georgia,serif;color:var(--ink);margin:2.5rem 0 1rem}
.about-body .emphasis-line{font-weight:800;color:var(--ink);font-size:1.15rem}
.about-body .signature{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line);color:var(--ink)}
